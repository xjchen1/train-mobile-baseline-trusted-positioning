+ matcpy(S,R,m,m);matcpy(xp,x,n,1);matmul("NN",n,m,n,1.,Ps,H,0.,F);matmul("TN",m,m,n,1.,H,F,1.,S);
+ if((info=matinv(S,m)))goto done;
+ matmul("NN",n,m,m,1.,F,S,0.,K);matmul("NN",n,1,m,1.,K,v,1.,xp);matmul("NT",n,n,m,-1.,K,H,1.,M);
+ matmul("NN",n,n,n,1.,M,Ps,0.,MP);matmul("NT",n,n,n,1.,MP,M,0.,Pp);matmul("NN",n,m,m,1.,K,R,0.,KR);matmul("NT",n,n,m,1.,KR,K,1.,Pp);
+ for(j=0;j<n;j++)for(i=0;i<j;i++){z=(Pp[i+j*n]+Pp[j+i*n])*.5;Pp[i+j*n]=Pp[j+i*n]=z;}
+ for(i=0;i<n;i++)if(!isfinite(xp[i])){info=-100;goto done;}
+ if(!chol_valid(Pp,n)){info=-100;goto done;}
+ done:free(Ps);free(F);free(S);free(K);free(M);free(MP);free(KR);return info;
+}
+
+extern int filter_active_prefix(double*x,double*P,const double*H,const double*v,
+ const double*R,int n,int m,int physical){
+ double *xx,*xp,*PP,*Pp,*HH;int i,j,k,info,*ix;
+ if(physical<1||physical>n||m<1)return -98;
+ for(i=0;i<physical;i++)if(!isfinite(x[i])||!isfinite(P[i+i*n])||P[i+i*n]<=0.)return -98;
+ for(i=0;i<n;i++)if(!isfinite(x[i]))return -98;
+ ix=imat(n,1);for(i=k=0;i<n;i++)if(P[i+i*n]>0.&&(i<physical||x[i]!=0.))ix[k++]=i;
+ if(k<physical){free(ix);return -98;}
+ xx=mat(k,1);xp=mat(k,1);PP=mat(k,k);Pp=mat(k,k);HH=mat(k,m);
+ for(i=0;i<k;i++){xx[i]=x[ix[i]];for(j=0;j<k;j++)PP[i+j*k]=P[ix[i]+ix[j]*n];for(j=0;j<m;j++)HH[i+j*k]=H[ix[i]+j*n];}
+ info=filter_joseph_(xx,PP,HH,v,R,k,m,xp,Pp);
+ if(!info){for(i=0;i<k;i++){x[ix[i]]=xp[i];for(j=0;j<k;j++)P[ix[i]+ix[j]*n]=Pp[i+j*k];}}
+ free(ix);free(xx);free(xp);free(PP);free(Pp);free(HH);return info;
+}
